# Worker env. Copy to .env (or .env.local) for local dev.
# In Railway, set these in the service's "Variables" panel.

# Supabase — service-role key has full DB access; never commit it.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Groq — free tier; use 8b-instant if you're fighting daily TPD limits.
GROQ_API_KEY=<groq-api-key>
GROQ_MODEL=llama-3.3-70b-versatile

# Run config (optional)
# AUDIT_CONCURRENCY=4         # parallel LLM calls per cell-batch
# AUDIT_CELL_LIMIT=10         # for smoke testing; processes only N cells
# AUDIT_DRY_RUN=true          # compute scores but don't call LLM and don't write
# AUDIT_TRIGGER_SOURCE=cron   # 'cron' | 'manual'
