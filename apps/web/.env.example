# Web app env. Copy to .env.local for local dev.
# In Vercel, set these in Project Settings → Environment Variables.
# Keep Production / Preview / Development scoped separately.

# Supabase — anon key is safe in the browser bundle; service-role key MUST
# stay server-only and is read only from API routes.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Groq — used by /api/ask. Free tier. Same key as the worker.
GROQ_API_KEY=<groq-api-key>
GROQ_MODEL=openai/gpt-oss-120b
GROQ_GUARD_MODEL=openai/gpt-oss-20b
